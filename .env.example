# Copia este archivo como .env y completa los valores

# Supabase Configuration
SUPABASE_URL=https://xxpwbkzxanrhtayzojly.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Scraping Settings
MERCADO_PUBLICO_BASE_URL=https://www.mercadopublico.cl
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_DOWNLOADS=3
USER_AGENT=MercadoPublicoScraper/1.0 (+contacto@example.com)

# Storage
STORAGE_BUCKET_NAME=licitaciones-documentos
MAX_FILE_SIZE_MB=100

# Opcional - Redis para rate limiting avanzado
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_TO_SUPABASE=true
